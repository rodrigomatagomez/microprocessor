
#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
#
# Groups
#
if {[catch {group get -using [list {ASSERTS}]}]} {
set createdGroup([list {ASSERTS}]) 1
catch {group new -name ASSERTS -overlay 0}
}
if {[info exists createdGroup([list {ASSERTS}])]} {
group using ASSERTS
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {microprocessor_top_tb.it_ast_xori_result}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_xor_}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_write_back_from_dmem}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_sub}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_srl}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_sra}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_sltu}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_sltiu_result}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_slti_result}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_slt}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_sll}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_s_type}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_prf_x0}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_prf_we}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_pc_aligned}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_pc_4}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_ori_result}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_or_}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_next_instr}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_lui}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_jal}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_imm_I_type}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_dmem_we}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_data_to_prf}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_bne}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_bltu}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_blt}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_bgeu}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_bge}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_beq}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_b_instr}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_auipc}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_andi_result}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_and_}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_addi_result}]} ] \
    [subst  {[format {microprocessor_top_tb.it_ast_add}]} ]
}

set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.clk}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.arst_n}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.pc_next[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.pc_q[31:0]}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.drive_if.driven_instr[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.instruction[31:0]}]}
	} ]]
waveform format $id -color #00ff00
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.rf_we}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.x0[32:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.wb_data[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.rs1[4:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.rs2[4:0]}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {signed(microprocessor_top_tb.vif.imm)}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.rs1_data[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.rs2_data[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.b_condition_rs1_rs2}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.alu_op1[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.alu_op2[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.alu_result[31:0]}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.dmem_we}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.dmem_rdata[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.dmem_addr[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.dmem_wdata[31:0]}]}
	} ]]

set groupId0 [waveform add -groups ASSERTS]
waveform hierarchy collapse $groupId0


waveform xview limits 71.093ns 78.907ns
