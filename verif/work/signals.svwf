
#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
#
# Groups
#
if {[catch {group get -using [list {ASSERTS}]}]} {
set createdGroup([list {ASSERTS}]) 1
catch {group new -name ASSERTS -overlay 0}
}
if {[catch {group get -using [list {PC}]}]} {
set createdGroup([list {PC}]) 1
catch {group new -name PC -overlay 0}
}
if {[catch {group get -using [list {PRF}]}]} {
set createdGroup([list {PRF}]) 1
catch {group new -name PRF -overlay 0}
}
if {[catch {group get -using [list {ALU}]}]} {
set createdGroup([list {ALU}]) 1
catch {group new -name ALU -overlay 0}
}
if {[catch {group get -using [list {Group 4}]}]} {
set createdGroup([list {Group 4}]) 1
catch {group new -name {Group 4} -overlay 0}
}
if {[catch {group get -using [list {Group 5}]}]} {
set createdGroup([list {Group 5}]) 1
catch {group new -name {Group 5} -overlay 0}
}
if {[catch {group get -using [list {IMM}]}]} {
set createdGroup([list {IMM}]) 1
catch {group new -name IMM -overlay 0}
}
if {[catch {group get -using [list {BRANCH}]}]} {
set createdGroup([list {BRANCH}]) 1
catch {group new -name BRANCH -overlay 0}
}
if {[catch {group get -using [list {DATAMEM}]}]} {
set createdGroup([list {DATAMEM}]) 1
catch {group new -name DATAMEM -overlay 0}
}
if {[catch {group get -using [list {Group 9}]}]} {
set createdGroup([list {Group 9}]) 1
catch {group new -name {Group 9} -overlay 0}
}
if {[catch {group get -using [list {ASSERTIONS}]}]} {
set createdGroup([list {ASSERTIONS}]) 1
catch {group new -name ASSERTIONS -overlay 0}
}
if {[info exists createdGroup([list {ASSERTS}])]} {
group using ASSERTS
group set -overlay 0
group set -comment {}
group clear 0 end

}

if {[info exists createdGroup([list {PC}])]} {
group using PC
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {microprocessor_top_tb.vif.pc_q[31:0]}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.pc_next[31:0]}]} ]
}

if {[info exists createdGroup([list {PRF}])]} {
group using PRF
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {microprocessor_top_tb.vif.rf_we}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.wb_data[31:0]}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.rs1[4:0]}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.rs2[4:0]}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.rs1_data[31:0]}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.rs2_data[31:0]}]} ]
}

if {[info exists createdGroup([list {ALU}])]} {
group using ALU
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {microprocessor_top_tb.vif.alu_result[31:0]}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.alu_op2[31:0]}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.alu_op1[31:0]}]} ]
}

if {[info exists createdGroup([list {Group 4}])]} {
group using {Group 4}
group set -overlay 0
group set -comment {}
group clear 0 end

}

if {[info exists createdGroup([list {Group 5}])]} {
group using {Group 5}
group set -overlay 0
group set -comment {}
group clear 0 end

}

if {[info exists createdGroup([list {IMM}])]} {
group using IMM
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {microprocessor_top_tb.vif.imm_sel[2:0]}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.imm[31:0]}]} ]
}

if {[info exists createdGroup([list {BRANCH}])]} {
group using BRANCH
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {microprocessor_top_tb.vif.branch_taken}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.b_condition_rs1_rs2}]} ]
}

if {[info exists createdGroup([list {DATAMEM}])]} {
group using DATAMEM
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {microprocessor_top_tb.vif.dmem_rdata[31:0]}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.dmem_wdata[31:0]}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.dmem_addr[31:0]}]} ] \
    [subst  {[format {microprocessor_top_tb.vif.dmem_we}]} ]
}

if {[info exists createdGroup([list {Group 9}])]} {
group using {Group 9}
group set -overlay 0
group set -comment {}
group clear 0 end

}

if {[info exists createdGroup([list {ASSERTIONS}])]} {
group using ASSERTIONS
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_xori_result}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_xori_result}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_xor_}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_x0_always_zero}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_write_back_from_dmem}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_sub}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_srl}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_sra}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_sltu}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_sltiu_result}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_slt}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_sll}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_s_type}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_prf_we}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_pc_aligned}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_pc_4}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_ori_result}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_or_}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_next_instr}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_lui}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_jal}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_imm_I_type}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_dmem_we}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_data_to_prf}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_cov_any_s_type}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_cov_any_r_type}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_cov_any_lui}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_cov_any_l_type}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_cov_any_jal}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_cov_any_i_type}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_cov_any_b_type}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_cov_any_auipc}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_bne}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_bltu}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_blt}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_bgeu}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_bge}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_beq}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_b_instr}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_auipc}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_andi_result}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_and_}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_addi_result}]} ] \
    [subst  {[format {microprocessor_top_tb.fv_microprocessor_top_i.it_ast_add}]} ]
}

set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.vif.clk}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.arst_n}]}
	} ]]

set groupId0 [waveform add -groups PC]
waveform hierarchy collapse $groupId0

set id [waveform add -signals [subst  {
	{[format {microprocessor_top_tb.u_kind_decode.actual_instruction[5:0]}]}
	} ]]

set groupId0 [waveform add -groups PRF]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups ALU]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups IMM]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups BRANCH]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups DATAMEM]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups ASSERTIONS]
waveform hierarchy collapse $groupId0


waveform xview limits 0 500.224ns
